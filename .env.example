# Telegram
SPLATBOT_TELEGRAM_TOKEN=123456:replace-me
SPLATBOT_ALLOWED_TELEGRAM_IDS=123456789,987654321
SPLATBOT_TELEGRAM_MODE=polling

# Paths on the light VPS
SPLATBOT_DATA_DIR=/var/lib/splatbot
SPLATBOT_DATABASE_PATH=/var/lib/splatbot/splatbot.sqlite3

# Object storage for raw uploads and large artifacts.
# Use Cloudflare R2, Backblaze B2, AWS S3, DigitalOcean Spaces, etc.
SPLATBOT_S3_ENDPOINT_URL=https://example.r2.cloudflarestorage.com
SPLATBOT_S3_REGION=auto
SPLATBOT_S3_BUCKET=splatbot
SPLATBOT_S3_ACCESS_KEY_ID=replace-me
SPLATBOT_S3_SECRET_ACCESS_KEY=replace-me
SPLATBOT_SIGNED_URL_TTL_SECONDS=604800
SPLATBOT_PUBLIC_BASE_URL=http://116.203.156.97
SPLATBOT_PUBLIC_RESULTS_DIR=/var/www/splatbot/results

# Upload/job limits
SPLATBOT_MIN_IMAGES=100
SPLATBOT_MAX_IMAGES=300
SPLATBOT_MAX_VIDEO_SECONDS=90
SPLATBOT_MAX_VIDEO_FRAMES=140
SPLATBOT_MAX_VIDEO_SAMPLE_FPS=12
SPLATBOT_MAX_VIDEO_CANDIDATE_FPS=30
SPLATBOT_DEFAULT_SCAN_MODE=scene
SPLATBOT_DEFAULT_SCAN_PRESET=balanced
SPLATBOT_JOB_RETENTION_DAYS=14
SPLATBOT_ADAPTIVE_FRAME_SELECTION=true
SPLATBOT_FRAME_QUALITY_REJECT_THRESHOLD=35
SPLATBOT_BLUR_REJECT_THRESHOLD=20
SPLATBOT_LOW_CONTRAST_REJECT_THRESHOLD=6
SPLATBOT_OVEREXPOSED_REJECT_THRESHOLD=0.55
SPLATBOT_UNDEREXPOSED_REJECT_THRESHOLD=0.55
SPLATBOT_DUPLICATE_FRAME_THRESHOLD=3
SPLATBOT_OBJECT_COLMAP_ORIGINAL_POSE_FALLBACK=true
SPLATBOT_COLMAP_RETRY_FRAME_COUNTS=120,80,60
SPLATBOT_COLMAP_RETRY_MATCHING_METHODS=sequential,exhaustive
SPLATBOT_OBJECT_MASK_BACKEND=rembg
SPLATBOT_OBJECT_MASK_COMMAND=
SPLATBOT_OBJECT_MASK_REFINE_ENABLED=true
SPLATBOT_OBJECT_MASK_QA_ENABLED=true
SPLATBOT_OBJECT_MASK_MIN_AREA_RATIO=0.01
SPLATBOT_OBJECT_MASK_MAX_AREA_RATIO=0.75
SPLATBOT_OBJECT_MASK_MAX_AREA_JUMP=0.45
SPLATBOT_OBJECT_MASK_MAX_EDGE_TOUCH_RATIO=0.35
SPLATBOT_OBJECT_MASK_MIN_KEEP_FRAMES=50
SPLATBOT_OBJECT_MASK_MIN_KEEP_RATIO=0.55
SPLATBOT_OBJECT_MASK_TRAINING_ALPHA_THRESHOLD=16
SPLATBOT_SILHOUETTE_CLEANUP_ENABLED=true
SPLATBOT_SILHOUETTE_CLEANUP_MIN_VIEWS=4
SPLATBOT_SILHOUETTE_CLEANUP_MAX_VIEWS=96
SPLATBOT_SILHOUETTE_CLEANUP_ALPHA_THRESHOLD=16
SPLATBOT_SILHOUETTE_CLEANUP_PADDING_PX=0
SPLATBOT_SILHOUETTE_CLEANUP_OUTSIDE_RATIO=0.45
SPLATBOT_SILHOUETTE_CLEANUP_MAX_INSIDE_VIEWS=8
SPLATBOT_SILHOUETTE_CLEANUP_MAX_INSIDE_RATIO=0.35
SPLATBOT_SILHOUETTE_CLEANUP_MAX_REMOVE_FRACTION=0.6
SPLATBOT_GAUSSIAN_CLEANUP_ENABLED=true
SPLATBOT_GAUSSIAN_CLEANUP_MIN_OPACITY=-7
SPLATBOT_GAUSSIAN_CLEANUP_MAX_SCALE_RATIO=10
SPLATBOT_GAUSSIAN_CLEANUP_MAX_ANISOTROPY=25
SPLATBOT_GAUSSIAN_CLEANUP_MAX_REMOVE_FRACTION=0.35
SPLATBOT_SPATIAL_CLEANUP_ENABLED=true
SPLATBOT_SPATIAL_OUTLIER_RADIUS_FRACTION=0.02
SPLATBOT_SPATIAL_OUTLIER_MIN_NEIGHBORS=3
SPLATBOT_SPATIAL_COMPONENT_VOXEL_FRACTION=0.025
SPLATBOT_SPATIAL_COMPONENT_MIN_VERTICES=500
SPLATBOT_SPATIAL_COMPONENT_MIN_FRACTION=0.005
SPLATBOT_SPATIAL_CLEANUP_MAX_REMOVE_FRACTION=0.35
SPLATBOT_POSTPROCESS_VALIDATION_ENABLED=true
SPLATBOT_POSTPROCESS_VALIDATION_MAX_OUTSIDE_FRACTION=0.2
SPLATBOT_FAST_MAX_VIDEO_FRAMES=90
SPLATBOT_FAST_TRAIN_MAX_ITERATIONS=7000
SPLATBOT_BEST_MAX_VIDEO_FRAMES=180
SPLATBOT_BEST_FRAME_SELECTION_STRATEGY=quality-diversity
SPLATBOT_BEST_SEGMENTATION_BACKENDS=sam2,rembg
SPLATBOT_BEST_SEGMENTATION_REQUIRED_BACKENDS=sam2
SPLATBOT_EXPERIMENTAL_SAM3_ENABLED=false
SPLATBOT_BEST_POSE_BACKENDS=vggt-colmap,mast3r-sfm
SPLATBOT_BEST_POSE_REQUIRED_BACKENDS=
SPLATBOT_DA3_MODEL=depth-anything/DA3-LARGE-1.1
SPLATBOT_DA3_USE_RAY_POSE=true
SPLATBOT_DA3_REF_VIEW_STRATEGY=middle
SPLATBOT_DA3_POSE_COMMAND='splatbot-da3 --images {images_dir} --processed {processed_dir}'
SPLATBOT_VGGT_ARGS='--use_ba --max_query_pts 2048 --query_frame_num 5'
SPLATBOT_MAST3R_MAX_IMAGES=80
SPLATBOT_MAST3R_USE_GLOMAP=true
SPLATBOT_GLOMAP_BIN=splatbot-glomap
SPLATBOT_GLOMAP_MAPPER_ARGS='--log_to_stderr=1 --ba_iteration_num=1 --GlobalPositioning.max_num_iterations=60 --BundleAdjustment.max_num_iterations=80'
SPLATBOT_BEST_DEPTH_BACKENDS=da3,depth-anything-v2-large
SPLATBOT_BEST_DEPTH_REQUIRED_BACKENDS=da3
SPLATBOT_DA3_DEPTH_COMMAND='splatbot-da3 --images {images_dir} --processed {processed_dir} --depth-only'
SPLATBOT_BEST_TRAIN_BACKENDS=3dgs-mcmc,splatfacto-big
SPLATBOT_BEST_TRAIN_REQUIRED_BACKENDS=3dgs-mcmc
SPLATBOT_MCMC_TRAIN_COMMAND='ns-train splatfacto-mcmc --data {processed_dir} --output-dir {ns_dir} --max-num-iterations {max_iterations} --steps-per-save {steps_per_save} --viewer.quit-on-train-completion True {extra_args}'
SPLATBOT_EXPERIMENTAL_DN_SPLATTER_ENABLED=false
SPLATBOT_BEST_TRAIN_METHOD=splatfacto-big
SPLATBOT_BEST_TRAIN_MAX_ITERATIONS=30000

# GPU worker command paths
SPLATBOT_FFMPEG_BIN=ffmpeg
SPLATBOT_FFPROBE_BIN=ffprobe
SPLATBOT_COLMAP_BIN=splatbot-colmap-wrapper
SPLATBOT_COLMAP_USE_GPU=true
SPLATBOT_NS_PROCESS_DATA_BIN=ns-process-data
SPLATBOT_NS_TRAIN_BIN=ns-train
SPLATBOT_NS_EXPORT_BIN=ns-export
SPLATBOT_NS_RENDER_BIN=ns-render
SPLATBOT_REMBG_BIN=rembg
SPLATBOT_REMBG_REQUIRE_GPU=true

# GPU provisioning/dispatch. Supported values: local, runpod.
# Use local only when bot and worker share a GPU machine.
SPLATBOT_WORKER_BACKEND=runpod

# RunPod GPU backend. The VPS launches an ephemeral pod, the pod SSHes back to
# pull media and push artifacts, then calls splatbot-jobctl on the VPS.
SPLATBOT_RUNPOD_API_KEY=replace-me
SPLATBOT_RUNPOD_GPU_TYPE_ID=NVIDIA H200,NVIDIA H200 NVL,NVIDIA H100 80GB HBM3,NVIDIA H100 PCIe,NVIDIA H100 NVL,NVIDIA A100-SXM4-80GB,NVIDIA A100 80GB PCIe,NVIDIA L40S,NVIDIA L40,NVIDIA RTX 6000 Ada Generation,NVIDIA RTX A6000,NVIDIA A40
SPLATBOT_RUNPOD_CLOUD_TYPE=ALL
SPLATBOT_RUNPOD_IMAGE_NAME=ghcr.io/navalgazing/splatbot-runpod:cuda-colmap
SPLATBOT_RUNPOD_CONTAINER_DISK_GB=80
SPLATBOT_RUNPOD_VOLUME_GB=80
SPLATBOT_RUNPOD_MIN_VCPU_COUNT=8
SPLATBOT_RUNPOD_MIN_MEMORY_GB=30
SPLATBOT_RUNPOD_NETWORK_VOLUME_ID=
SPLATBOT_RUNPOD_DATA_CENTER_IDS=
SPLATBOT_RUNPOD_POD_SSH_KEY=/etc/splatbot/runpod_pod_key
SPLATBOT_RUNPOD_SSH_READY_TIMEOUT_SECONDS=3600
SPLATBOT_RUNPOD_NO_ENDPOINT_TIMEOUT_SECONDS=1500
SPLATBOT_RUNPOD_LAUNCH_ATTEMPTS=5
SPLATBOT_RUNPOD_VPS_HOST=116.203.156.97
SPLATBOT_RUNPOD_VPS_USER=root
SPLATBOT_RUNPOD_VPS_SSH_KEY=/etc/splatbot/runpod_worker_key
SPLATBOT_RUNPOD_VENV=/opt/splatbot/venv
SPLATBOT_RUNPOD_RUNTIME_CACHE_VERSION=splatbot-runtime-2026-04-26-v1
SPLATBOT_RUNPOD_RUNTIME_CACHE_MARKER=/workspace/.splatbot-runtime-cache-version
SPLATBOT_RUNPOD_BOOTSTRAP_COMMAND=
SPLATBOT_RUNPOD_SETUP_COMMAND=

# For the lean RunPod image in Dockerfile.runpod plus a warmed network volume, set:
# SPLATBOT_RUNPOD_IMAGE_NAME=ghcr.io/navalgazing/splatbot-runpod:latest
# SPLATBOT_RUNPOD_VENV=/workspace/venv
# SPLATBOT_RUNPOD_BOOTSTRAP_COMMAND=
# SPLATBOT_COLMAP_USE_GPU=true
