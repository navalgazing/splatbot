# Telegram
SPLATBOT_TELEGRAM_TOKEN=123456:replace-me
SPLATBOT_ALLOWED_TELEGRAM_IDS=123456789,987654321
SPLATBOT_TELEGRAM_MODE=polling

# Paths on the light VPS
SPLATBOT_DATA_DIR=/var/lib/splatbot
SPLATBOT_DATABASE_PATH=/var/lib/splatbot/splatbot.sqlite3

# Object storage for raw uploads and large artifacts.
# Use Cloudflare R2, Backblaze B2, AWS S3, DigitalOcean Spaces, etc.
SPLATBOT_S3_ENDPOINT_URL=https://example.r2.cloudflarestorage.com
SPLATBOT_S3_REGION=auto
SPLATBOT_S3_BUCKET=splatbot
SPLATBOT_S3_ACCESS_KEY_ID=replace-me
SPLATBOT_S3_SECRET_ACCESS_KEY=replace-me
SPLATBOT_SIGNED_URL_TTL_SECONDS=604800
SPLATBOT_PUBLIC_BASE_URL=http://116.203.156.97
SPLATBOT_PUBLIC_RESULTS_DIR=/var/www/splatbot/results

# Upload/job limits
SPLATBOT_MIN_IMAGES=100
SPLATBOT_MAX_IMAGES=300
SPLATBOT_MAX_VIDEO_SECONDS=90
SPLATBOT_MAX_VIDEO_FRAMES=140
SPLATBOT_MAX_VIDEO_SAMPLE_FPS=10
SPLATBOT_DEFAULT_SCAN_MODE=scene
SPLATBOT_JOB_RETENTION_DAYS=14

# GPU worker command paths
SPLATBOT_FFMPEG_BIN=ffmpeg
SPLATBOT_FFPROBE_BIN=ffprobe
SPLATBOT_COLMAP_BIN=colmap
SPLATBOT_NS_PROCESS_DATA_BIN=ns-process-data
SPLATBOT_NS_TRAIN_BIN=ns-train
SPLATBOT_NS_EXPORT_BIN=ns-export
SPLATBOT_NS_RENDER_BIN=ns-render
SPLATBOT_REMBG_BIN=rembg

# GPU provisioning/dispatch. Supported values: local, runpod.
# Use local only when bot and worker share a GPU machine.
SPLATBOT_WORKER_BACKEND=runpod

# RunPod GPU backend. The VPS launches an ephemeral pod, the pod SSHes back to
# pull media and push artifacts, then calls splatbot-jobctl on the VPS.
SPLATBOT_RUNPOD_API_KEY=replace-me
SPLATBOT_RUNPOD_GPU_TYPE_ID=NVIDIA GeForce RTX 4090
SPLATBOT_RUNPOD_CLOUD_TYPE=ALL
SPLATBOT_RUNPOD_IMAGE_NAME=runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04
SPLATBOT_RUNPOD_CONTAINER_DISK_GB=80
SPLATBOT_RUNPOD_VOLUME_GB=80
SPLATBOT_RUNPOD_MIN_VCPU_COUNT=8
SPLATBOT_RUNPOD_MIN_MEMORY_GB=30
SPLATBOT_RUNPOD_POD_SSH_KEY=/etc/splatbot/runpod_pod_key
SPLATBOT_RUNPOD_SSH_READY_TIMEOUT_SECONDS=900
SPLATBOT_RUNPOD_VPS_HOST=116.203.156.97
SPLATBOT_RUNPOD_VPS_USER=root
SPLATBOT_RUNPOD_VPS_SSH_KEY=/etc/splatbot/runpod_worker_key
SPLATBOT_RUNPOD_BOOTSTRAP_COMMAND=apt-get update && apt-get install -y openssh-client rsync curl ffmpeg colmap python3 python3-venv python3-pip build-essential
SPLATBOT_RUNPOD_SETUP_COMMAND=/workspace/venv/bin/pip install nerfstudio 'rembg[cpu,cli]'

# For the prebuilt RunPod image in Dockerfile.runpod, set:
# SPLATBOT_RUNPOD_IMAGE_NAME=ghcr.io/navalgazing/splatbot-runpod:latest
# SPLATBOT_RUNPOD_VENV=/opt/splatbot/venv
# SPLATBOT_RUNPOD_BOOTSTRAP_COMMAND=
# SPLATBOT_RUNPOD_SETUP_COMMAND=
