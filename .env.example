# Telegram
SPLATBOT_TELEGRAM_TOKEN=123456:replace-me
SPLATBOT_ALLOWED_TELEGRAM_IDS=123456789,987654321
SPLATBOT_TELEGRAM_MODE=polling

# Paths on the light VPS
SPLATBOT_DATA_DIR=/var/lib/splatbot
SPLATBOT_DATABASE_PATH=/var/lib/splatbot/splatbot.sqlite3

# Object storage for raw uploads and large artifacts.
# Use Cloudflare R2, Backblaze B2, AWS S3, DigitalOcean Spaces, etc.
SPLATBOT_S3_ENDPOINT_URL=https://example.r2.cloudflarestorage.com
SPLATBOT_S3_REGION=auto
SPLATBOT_S3_BUCKET=splatbot
SPLATBOT_S3_ACCESS_KEY_ID=replace-me
SPLATBOT_S3_SECRET_ACCESS_KEY=replace-me
SPLATBOT_SIGNED_URL_TTL_SECONDS=604800

# Upload/job limits
SPLATBOT_MIN_IMAGES=100
SPLATBOT_MAX_IMAGES=300
SPLATBOT_MAX_VIDEO_SECONDS=90
SPLATBOT_DEFAULT_SCAN_MODE=scene
SPLATBOT_JOB_RETENTION_DAYS=14

# GPU worker command paths
SPLATBOT_FFMPEG_BIN=ffmpeg
SPLATBOT_COLMAP_BIN=colmap
SPLATBOT_NS_PROCESS_DATA_BIN=ns-process-data
SPLATBOT_NS_TRAIN_BIN=ns-train
SPLATBOT_NS_EXPORT_BIN=ns-export
SPLATBOT_NS_RENDER_BIN=ns-render
SPLATBOT_REMBG_BIN=rembg

# GPU provisioning/dispatch is intentionally external at first.
# Set to local when bot and worker share a machine, ssh when the dispatcher calls a GPU host.
SPLATBOT_WORKER_BACKEND=ssh
SPLATBOT_GPU_SSH_HOST=ubuntu@gpu-host
SPLATBOT_GPU_SSH_KEY=/etc/splatbot/gpu_worker_key
SPLATBOT_GPU_WORKDIR=/srv/splatbot

