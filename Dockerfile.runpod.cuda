ARG RUNPOD_BASE=runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04
ARG SPLATBOT_STABLE_IMAGE=ghcr.io/navalgazing/splatbot-runpod:latest
ARG SPLATBOT_BASE_REFRESH=2026-04-28-wheel
ARG NERFSTUDIO_COMMIT=50e0e3c70c775e89333256213363badbf074f29d
ARG VGGT_COMMIT=44b3afbd1869d8bde4894dd8ea1e293112dd5eba
ARG MAST3R_COMMIT=f5209afc300cec36239a7ac992263f36847bbba0
ARG GLOMAP_COMMIT=0edb1b8435e0f9a594318908b81a31f078a51bf7

FROM ${RUNPOD_BASE} AS colmap-builder

ARG COLMAP_VERSION=3.9.1
ARG CUDA_ARCHITECTURES=80;86;89;90
ARG GLOMAP_COMMIT

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=/usr/local/cuda/bin:$PATH
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
ENV TORCH_CUDA_ARCH_LIST=8.0;8.6;8.9;9.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      git \
      libgflags-dev \
      libboost-filesystem-dev \
      libboost-graph-dev \
      libboost-program-options-dev \
      libboost-system-dev \
      libceres-dev \
      libcgal-dev \
      libeigen3-dev \
      libflann-dev \
      libfreeimage-dev \
      libglew-dev \
      libgoogle-glog-dev \
      liblz4-dev \
      libmetis-dev \
      libsqlite3-dev \
      libsuitesparse-dev \
      ninja-build \
      python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --branch "${COLMAP_VERSION}" --depth 1 https://github.com/colmap/colmap.git /tmp/colmap \
    && cmake -S /tmp/colmap -B /tmp/colmap/build -GNinja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" \
      -DCMAKE_INSTALL_PREFIX=/opt/colmap-cuda \
      -DCUDA_ENABLED=ON \
      -DGUI_ENABLED=OFF \
      -DOPENGL_ENABLED=OFF \
      -DCGAL_ENABLED=OFF \
      -DTESTS_ENABLED=OFF \
      -DCMAKE_INSTALL_MESSAGE=NEVER \
    && cmake --build /tmp/colmap/build --parallel "$(nproc)" > /tmp/colmap-build.log 2>&1 \
      || { tail -n 200 /tmp/colmap-build.log; exit 1; } \
    && cmake --install /tmp/colmap/build > /tmp/colmap-install.log 2>&1 \
      || { tail -n 200 /tmp/colmap-install.log; exit 1; } \
    && rm -rf /tmp/colmap

RUN python3 -m pip install --no-cache-dir --upgrade "cmake>=3.28,<4" \
    && git clone https://github.com/colmap/glomap.git /tmp/glomap \
    && git -C /tmp/glomap checkout "$GLOMAP_COMMIT" \
    && cmake -S /tmp/glomap -B /tmp/glomap/build -GNinja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/glomap \
      -DCUDA_ENABLED=OFF \
      -DCGAL_ENABLED=ON \
      -DGUI_ENABLED=OFF \
      -DOPENGL_ENABLED=OFF \
      -DTESTS_ENABLED=OFF \
      -DCMAKE_INSTALL_MESSAGE=NEVER \
    && cmake --build /tmp/glomap/build --parallel "$(nproc)" > /tmp/glomap-build.log 2>&1 \
      || { tail -n 240 /tmp/glomap-build.log; exit 1; } \
    && cmake --install /tmp/glomap/build > /tmp/glomap-install.log 2>&1 \
      || { tail -n 200 /tmp/glomap-install.log; exit 1; } \
    && /opt/glomap/bin/glomap -h >/tmp/glomap-help.txt \
    && rm -rf /tmp/glomap

FROM ${SPLATBOT_STABLE_IMAGE}

ARG NERFSTUDIO_COMMIT
ARG VGGT_COMMIT
ARG MAST3R_COMMIT
ARG DOWNLOAD_VGGT_WEIGHTS=0
ARG DOWNLOAD_MAST3R_WEIGHTS=0
ARG VGGT_WEIGHTS_URL=https://huggingface.co/facebook/VGGT-1B/resolve/main/model.pt
ARG VGGSFM_TRACKER_WEIGHTS_URL=https://huggingface.co/facebook/VGGSfM/resolve/main/vggsfm_v2_tracker.pt
ARG DINOV2_VITB14_REG_WEIGHTS_URL=https://dl.fbaipublicfiles.com/dinov2/dinov2_vitb14/dinov2_vitb14_reg4_pretrain.pth
ARG ALIKED_N16_WEIGHTS_URL=https://raw.githubusercontent.com/Shiaoming/ALIKED/main/models/aliked-n16.pth
ARG SUPERPOINT_WEIGHTS_URL=https://github.com/cvg/LightGlue/releases/download/v0.1_arxiv/superpoint_v1.pth
ARG MAST3R_WEIGHTS_URL=https://download.europe.naverlabs.com/ComputerVision/MASt3R/MASt3R_ViTLarge_BaseDecoder_512_catmlpdpt_metric.pth
ARG DOWNLOAD_DA3_MODEL=0

ENV DEBIAN_FRONTEND=noninteractive
ENV SPLATBOT_VGGT_REPO=/opt/vggt
ENV SPLATBOT_VGGT_WEIGHTS=/opt/splatbot/models/torch/hub/checkpoints/model.pt
ENV SPLATBOT_VGGT_WEIGHTS_URL=${VGGT_WEIGHTS_URL}
ENV SPLATBOT_VGGSFM_TRACKER_WEIGHTS=/opt/splatbot/models/torch/hub/checkpoints/vggsfm_v2_tracker.pt
ENV SPLATBOT_VGGSFM_TRACKER_WEIGHTS_URL=${VGGSFM_TRACKER_WEIGHTS_URL}
ENV SPLATBOT_DINOV2_HUB_REPO=/opt/splatbot/models/torch/hub/facebookresearch_dinov2_main
ENV SPLATBOT_DINOV2_VITB14_REG_WEIGHTS=/opt/splatbot/models/torch/hub/checkpoints/dinov2_vitb14_reg4_pretrain.pth
ENV SPLATBOT_DINOV2_VITB14_REG_WEIGHTS_URL=${DINOV2_VITB14_REG_WEIGHTS_URL}
ENV SPLATBOT_ALIKED_N16_WEIGHTS=/opt/splatbot/models/torch/hub/checkpoints/aliked-n16.pth
ENV SPLATBOT_ALIKED_N16_WEIGHTS_URL=${ALIKED_N16_WEIGHTS_URL}
ENV SPLATBOT_SUPERPOINT_WEIGHTS=/opt/splatbot/models/torch/hub/checkpoints/superpoint_v1.pth
ENV SPLATBOT_SUPERPOINT_WEIGHTS_URL=${SUPERPOINT_WEIGHTS_URL}
ENV SPLATBOT_VGGT_ALLOW_WEIGHT_DOWNLOAD=false
ENV SPLATBOT_MAST3R_REPO=/opt/mast3r
ENV SPLATBOT_MAST3R_WEIGHTS=/opt/splatbot/models/mast3r/MASt3R_ViTLarge_BaseDecoder_512_catmlpdpt_metric.pth
ENV SPLATBOT_MAST3R_WEIGHTS_URL=${MAST3R_WEIGHTS_URL}
ENV SPLATBOT_MAST3R_ALLOW_WEIGHT_DOWNLOAD=true
ENV SPLATBOT_DA3_MODEL=depth-anything/DA3-LARGE-1.1
ENV SPLATBOT_DA3_MODEL_CACHE_DIR=/opt/splatbot/models/da3
ENV SPLATBOT_DA3_ALLOW_MODEL_DOWNLOAD=true
ENV SPLATBOT_DA3_MODEL_DOWNLOAD_ATTEMPTS=5
ENV TORCH_HOME=/opt/splatbot/models/torch
ENV SPLATBOT_TORCHVISION_ALLOW_WEIGHT_DOWNLOAD=false
ENV TORCH_CUDA_ARCH_LIST=8.0;8.6;8.9;9.0
ENV U2NET_HOME=/opt/splatbot/models/rembg

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      libboost-filesystem1.74.0 \
      libboost-graph1.74.0 \
      libboost-program-options1.74.0 \
      libboost-system1.74.0 \
      libceres2 \
      libflann1.9 \
      libfreeimage3 \
      libgflags2.2 \
      libgl1 \
      libglew2.2 \
      libgomp1 \
      libgoogle-glog0v5 \
      liblz4-1 \
      libmetis5 \
      libopengl0 \
      libsqlite3-0 \
      curl \
      git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=colmap-builder /opt/colmap-cuda/ /usr/local/
COPY --from=colmap-builder /opt/glomap/ /usr/local/

ENV SPLATBOT_SAM2_CHECKPOINT=/opt/splatbot/models/sam2.1_hiera_large.pt
ENV SPLATBOT_SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_l.yaml

RUN /opt/splatbot/venv/bin/pip uninstall -y onnxruntime onnxruntime-gpu || true \
    && /opt/splatbot/venv/bin/pip install --no-cache-dir --upgrade "rembg[gpu,cli]" onnxruntime-gpu

RUN mkdir -p "$U2NET_HOME" \
    && if [ -s /root/.u2net/u2net.onnx ]; then \
      cp /root/.u2net/u2net.onnx "$U2NET_HOME/u2net.onnx"; \
    else \
      curl -fsSL \
        https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2net.onnx \
        -o "$U2NET_HOME/u2net.onnx"; \
    fi \
    && test "$(stat -c%s "$U2NET_HOME/u2net.onnx")" -gt 1000000

RUN /opt/splatbot/venv/bin/pip install --no-cache-dir --upgrade --force-reinstall --no-deps \
      "git+https://github.com/nerfstudio-project/nerfstudio.git@${NERFSTUDIO_COMMIT}"

RUN mkdir -p "$TORCH_HOME/hub/checkpoints" \
    && /opt/splatbot/venv/bin/python - <<'PY'
import os
from pathlib import Path
from torch.hub import download_url_to_file

url = "https://download.pytorch.org/models/alexnet-owt-7be5be79.pth"
checkpoint = Path(os.environ["TORCH_HOME"]) / "hub" / "checkpoints" / Path(url).name
checkpoint.parent.mkdir(parents=True, exist_ok=True)
if not checkpoint.exists() or checkpoint.stat().st_size < 100_000_000:
    partial = checkpoint.with_suffix(checkpoint.suffix + ".part")
    if partial.exists():
        partial.unlink()
    download_url_to_file(url, str(partial), hash_prefix="7be5be79", progress=True)
    partial.replace(checkpoint)
if checkpoint.stat().st_size < 100_000_000:
    raise SystemExit(f"AlexNet LPIPS checkpoint is too small: {checkpoint}")
print(f"AlexNet LPIPS checkpoint cached at {checkpoint} bytes={checkpoint.stat().st_size}")
PY

RUN /opt/splatbot/venv/bin/pip install --no-cache-dir \
      git+https://github.com/facebookresearch/sam2.git \
    && /opt/splatbot/venv/bin/python - <<'PY'
import importlib

for module in ("sam2",):
    try:
        importlib.import_module(module)
    except Exception as exc:
        raise SystemExit(f"{module} is not importable: {exc}") from exc
PY

RUN mkdir -p /opt/splatbot/models \
    && curl -fsSL \
      https://dl.fbaipublicfiles.com/segment_anything_2/092824/sam2.1_hiera_large.pt \
      -o "$SPLATBOT_SAM2_CHECKPOINT" \
    && test -s "$SPLATBOT_SAM2_CHECKPOINT"

RUN git clone --filter=blob:none https://github.com/facebookresearch/vggt.git "$SPLATBOT_VGGT_REPO" \
    && git -C "$SPLATBOT_VGGT_REPO" checkout "$VGGT_COMMIT" \
    && git clone --filter=blob:none --depth 1 https://github.com/facebookresearch/dinov2.git "$SPLATBOT_DINOV2_HUB_REPO" \
    && git clone --filter=blob:none https://github.com/naver/mast3r.git "$SPLATBOT_MAST3R_REPO" \
    && git -C "$SPLATBOT_MAST3R_REPO" checkout "$MAST3R_COMMIT" \
    && git -C "$SPLATBOT_MAST3R_REPO" submodule update --init --recursive --depth 1

RUN if [ "$DOWNLOAD_MAST3R_WEIGHTS" = "1" ]; then \
      mkdir -p "$(dirname "$SPLATBOT_MAST3R_WEIGHTS")" \
      && curl -fL --retry 5 --retry-delay 5 -o "$SPLATBOT_MAST3R_WEIGHTS" "$SPLATBOT_MAST3R_WEIGHTS_URL" \
      && test "$(stat -c%s "$SPLATBOT_MAST3R_WEIGHTS")" -gt 1000000000; \
    fi

RUN /opt/splatbot/venv/bin/pip install --no-cache-dir \
      "huggingface-hub[torch]>=0.22" \
      einops \
      safetensors \
      scipy \
      opencv-python \
      trimesh \
      matplotlib \
      tqdm \
      hydra-core \
      omegaconf \
      requests \
      pycolmap==3.10.0 \
      pyceres==2.3 \
      roma \
      scikit-learn \
      cython \
      kapture \
      kapture-localization \
      "pyglet<2" \
      tensorboard \
      "git+https://github.com/jytime/LightGlue.git#egg=lightglue" \
    && /opt/splatbot/venv/bin/python - <<'PY'
from pathlib import Path
import sysconfig

site_packages = Path(sysconfig.get_paths()["purelib"])
(site_packages / "splatbot-vggt-mast3r.pth").write_text(
    "/opt/vggt\n/opt/mast3r\n/opt/mast3r/dust3r\n",
    encoding="utf-8",
)
PY

RUN if [ "$DOWNLOAD_VGGT_WEIGHTS" = "1" ]; then \
      mkdir -p "$(dirname "$SPLATBOT_VGGT_WEIGHTS")" \
      && curl -fL --retry 5 --retry-delay 5 --retry-all-errors \
        -o "$SPLATBOT_VGGT_WEIGHTS" "$SPLATBOT_VGGT_WEIGHTS_URL" \
      && test "$(stat -c%s "$SPLATBOT_VGGT_WEIGHTS")" -gt 4000000000 \
      && curl -fL --retry 5 --retry-delay 5 --retry-all-errors \
        -o "$SPLATBOT_VGGSFM_TRACKER_WEIGHTS" "$SPLATBOT_VGGSFM_TRACKER_WEIGHTS_URL" \
      && test "$(stat -c%s "$SPLATBOT_VGGSFM_TRACKER_WEIGHTS")" -gt 100000000 \
      && curl -fL --retry 5 --retry-delay 5 --retry-all-errors \
        -o "$SPLATBOT_DINOV2_VITB14_REG_WEIGHTS" "$SPLATBOT_DINOV2_VITB14_REG_WEIGHTS_URL" \
      && test "$(stat -c%s "$SPLATBOT_DINOV2_VITB14_REG_WEIGHTS")" -gt 300000000 \
      && curl -fL --retry 5 --retry-delay 5 --retry-all-errors \
        -o "$SPLATBOT_ALIKED_N16_WEIGHTS" "$SPLATBOT_ALIKED_N16_WEIGHTS_URL" \
      && test "$(stat -c%s "$SPLATBOT_ALIKED_N16_WEIGHTS")" -gt 2000000 \
      && curl -fL --retry 5 --retry-delay 5 --retry-all-errors \
        -o "$SPLATBOT_SUPERPOINT_WEIGHTS" "$SPLATBOT_SUPERPOINT_WEIGHTS_URL" \
      && test "$(stat -c%s "$SPLATBOT_SUPERPOINT_WEIGHTS")" -gt 4000000; \
    fi

RUN /opt/splatbot/venv/bin/python - <<'PY'
import os
import urllib.error
from pathlib import Path

import torch

repo = Path(os.environ["SPLATBOT_DINOV2_HUB_REPO"])
weights = Path(os.environ["SPLATBOT_DINOV2_VITB14_REG_WEIGHTS"])
if not repo.joinpath("hubconf.py").is_file():
    raise SystemExit(f"DINOv2 torch hub repo is missing: {repo}")
if not weights.is_file() or weights.stat().st_size <= 300_000_000:
    raise SystemExit(f"DINOv2 weights are missing or too small: {weights}")

def offline_urlopen(*args, **kwargs):
    raise urllib.error.URLError("offline cache validation")

torch.hub.urlopen = offline_urlopen
model = torch.hub.load("facebookresearch/dinov2", "dinov2_vitb14_reg", verbose=False)
print(f"DINOv2 torch hub cache validated: {type(model).__name__}")
PY

RUN /opt/splatbot/venv/bin/python - <<'PY'
import os
import urllib.error
from pathlib import Path

import torch
from lightglue import ALIKED, SuperPoint

aliked = Path(os.environ["SPLATBOT_ALIKED_N16_WEIGHTS"])
if not aliked.is_file() or aliked.stat().st_size <= 2_000_000:
    raise SystemExit(f"ALIKED N16 weights are missing or too small: {aliked}")
superpoint = Path(os.environ["SPLATBOT_SUPERPOINT_WEIGHTS"])
if not superpoint.is_file() or superpoint.stat().st_size <= 4_000_000:
    raise SystemExit(f"SuperPoint weights are missing or too small: {superpoint}")

def offline_urlopen(*args, **kwargs):
    raise urllib.error.URLError("offline cache validation")

torch.hub.urlopen = offline_urlopen
aliked_model = ALIKED(max_num_keypoints=16, detection_threshold=0.005)
superpoint_model = SuperPoint(max_num_keypoints=16, detection_threshold=0.005)
print(f"LightGlue cache validated: {type(aliked_model).__name__}, {type(superpoint_model).__name__}")
PY

RUN if [ "$DOWNLOAD_DA3_MODEL" = "1" ]; then \
      /opt/splatbot/venv/bin/python -c 'import os, re; from pathlib import Path; from huggingface_hub import snapshot_download; model=os.environ["SPLATBOT_DA3_MODEL"]; safe=re.sub(r"[^A-Za-z0-9._-]+", "__", model); target=Path(os.environ["SPLATBOT_DA3_MODEL_CACHE_DIR"]) / safe; target.mkdir(parents=True, exist_ok=True); snapshot_download(repo_id=model, local_dir=str(target), resume_download=True); print(f"DA3 model cached at {target}")'; \
    fi

RUN set -eu; \
    export PATH="/opt/splatbot/venv/bin:$PATH"; \
    ldconfig; \
    for cmd in ffmpeg ffprobe colmap glomap nvcc ns-process-data ns-train ns-export ns-render rembg da3; do \
      path="$(command -v "$cmd" || true)"; \
      if [ -z "$path" ]; then \
        echo "missing command: $cmd"; \
        exit 1; \
      fi; \
      echo "$cmd=$path"; \
      case "$cmd" in \
        ns-process-data|ns-train|ns-export|ns-render|rembg|da3) \
          "$cmd" --help > "/tmp/$cmd-help.txt" 2>&1 || { echo "$cmd --help failed"; tail -n 40 "/tmp/$cmd-help.txt"; exit 1; }; \
          ;; \
      esac; \
    done; \
    colmap -h > /tmp/colmap-help.txt 2>&1 || { echo "colmap -h failed"; cat /tmp/colmap-help.txt; exit 1; }; \
    sed -n '1,4p' /tmp/colmap-help.txt; \
    if ! grep -q "with CUDA" /tmp/colmap-help.txt; then \
      echo "COLMAP help did not report CUDA support"; \
      sed -n '1,12p' /tmp/colmap-help.txt; \
      exit 1; \
    fi; \
    colmap feature_extractor -h > /tmp/colmap-feature-extractor-help.txt 2>&1 \
      || { echo "colmap feature_extractor -h failed"; cat /tmp/colmap-feature-extractor-help.txt; exit 1; }; \
    if ! grep -q "SiftExtraction.use_gpu" /tmp/colmap-feature-extractor-help.txt; then \
      echo "feature_extractor help did not list SiftExtraction.use_gpu"; \
      tail -n 40 /tmp/colmap-feature-extractor-help.txt; \
      exit 1; \
    fi; \
    glomap -h > /tmp/glomap-help.txt 2>&1 \
      || { echo "glomap -h failed"; cat /tmp/glomap-help.txt; exit 1; }; \
    ns-train --help > /tmp/ns-train-methods.txt 2>&1; \
    if ! grep -q "splatfacto-mcmc" /tmp/ns-train-methods.txt; then \
      echo "ns-train method list did not include splatfacto-mcmc"; \
      tail -n 80 /tmp/ns-train-methods.txt; \
      exit 1; \
    fi; \
    ns-train splatfacto-mcmc --max-num-iterations 1 --steps-per-save 1 --viewer.quit-on-train-completion True --help \
      > /tmp/ns-train-splatfacto-mcmc-help.txt 2>&1 \
      || { echo "splatfacto-mcmc option validation failed"; tail -n 120 /tmp/ns-train-splatfacto-mcmc-help.txt; exit 1; }; \
    python /opt/vggt/demo_colmap.py --help > /tmp/vggt-demo-colmap-help.txt 2>&1 \
      || { echo "VGGT demo_colmap help failed"; tail -n 120 /tmp/vggt-demo-colmap-help.txt; exit 1; }; \
    python /opt/mast3r/kapture_mast3r_mapping.py --help > /tmp/mast3r-mapping-help.txt 2>&1 \
      || { echo "MASt3R mapping help failed"; tail -n 120 /tmp/mast3r-mapping-help.txt; exit 1; }

RUN /opt/splatbot/venv/bin/python - <<'PY'
import importlib.metadata as metadata
import importlib
import importlib.util
import os
from pathlib import Path
import onnxruntime as ort
import torch
from nerfstudio.configs.method_configs import method_configs
from nerfstudio.models.splatfacto import SplatfactoModelConfig

def require_import(module: str) -> None:
    try:
        importlib.import_module(module)
    except Exception as exc:
        raise SystemExit(f"{module} is not importable: {exc}") from exc
    print(f"{module}=importable")

def optional_import(module: str) -> None:
    if importlib.util.find_spec(module) is None:
        print(f"{module}=missing")
        return
    require_import(module)

for package in (
    "nerfstudio",
    "gsplat",
    "rembg",
    "onnxruntime",
    "onnxruntime-gpu",
    "torch",
    "depth-anything-3",
    "xformers",
    "pycolmap",
    "pyceres",
    "kapture",
    "kapture-localization",
):
    try:
        version = metadata.version(package)
    except metadata.PackageNotFoundError:
        version = "missing"
    print(f"{package}={version}")
print(f"torch_cuda_available={torch.cuda.is_available()}")
print(f"onnxruntime_device={ort.get_device()}")
print(f"onnxruntime_providers={ort.get_available_providers()}")
u2net_model = Path(os.environ["U2NET_HOME"]) / "u2net.onnx"
if not u2net_model.exists() or u2net_model.stat().st_size < 1_000_000:
    raise SystemExit(f"baked rembg model is missing or too small: {u2net_model}")
print(f"u2net_model={u2net_model} bytes={u2net_model.stat().st_size}")
require_import("sam2")
require_import("depth_anything_3")
require_import("xformers")
require_import("vggt")
require_import("mast3r")
require_import("dust3r")
require_import("lightglue")
require_import("pycolmap")
if "splatfacto-mcmc" not in method_configs:
    raise SystemExit("nerfstudio does not register splatfacto-mcmc")
if getattr(SplatfactoModelConfig(), "strategy", None) != "default":
    raise SystemExit("splatfacto strategy field is missing or invalid")
if "CUDAExecutionProvider" not in ort.get_available_providers():
    raise SystemExit("onnxruntime-gpu did not expose CUDAExecutionProvider")
PY
