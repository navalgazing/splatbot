FROM runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV SPLATBOT_RUNPOD_VENV=/opt/splatbot/venv
ENV PATH=/opt/splatbot/venv/bin:$PATH
ENV PIP_NO_CACHE_DIR=1
ENV QT_QPA_PLATFORM=offscreen

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      colmap \
      curl \
      ffmpeg \
      openssh-client \
      python3 \
      python3-pip \
      python3-venv \
      rsync \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/splatbot/venv \
    && /opt/splatbot/venv/bin/pip install --upgrade pip \
    && /opt/splatbot/venv/bin/pip install boto3 nerfstudio rembg \
    && command -v ffmpeg \
    && command -v colmap \
    && command -v ns-process-data \
    && command -v ns-train \
    && command -v ns-export \
    && command -v ns-render \
    && command -v rembg
