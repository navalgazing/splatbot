FROM runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04

ARG DA3_COMMIT=41736238f5bced4debf3f2a12375d2466874866d

ENV DEBIAN_FRONTEND=noninteractive
ENV SPLATBOT_RUNPOD_VENV=/opt/splatbot/venv
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=/usr/local/cuda/bin:$PATH
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
ENV TORCH_CUDA_ARCH_LIST=8.9
ENV TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
ENV TORCH_EXTENSIONS_DIR=/workspace/torch_extensions
ENV TORCHINDUCTOR_CACHE_DIR=/workspace/torch_inductor
ENV TRITON_CACHE_DIR=/workspace/triton_cache
ENV CUDA_CACHE_PATH=/workspace/cuda_cache
ENV XDG_CACHE_HOME=/workspace/.cache
ENV TORCH_HOME=/workspace/.cache/torch
ENV U2NET_HOME=/root/.u2net
ENV QT_QPA_PLATFORM=offscreen

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      colmap \
      curl \
      ffmpeg \
      git \
      openssh-client \
      python3 \
      python3-pip \
      python3-venv \
      rsync \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/splatbot/venv \
    && /opt/splatbot/venv/bin/pip install --upgrade pip \
    && /opt/splatbot/venv/bin/pip install --index-url https://download.pytorch.org/whl/cu128 \
      torch==2.8.0 \
      torchvision==0.23.0 \
      torchaudio==2.8.0 \
    && /opt/splatbot/venv/bin/pip install --no-cache-dir \
      xformers==0.0.32.post2 \
    && /opt/splatbot/venv/bin/pip install \
      aiosqlite \
      boto3 \
      nerfstudio \
      pydantic-settings \
      python-dotenv \
      python-telegram-bot \
      'rembg[cpu,cli]' \
    && git clone https://github.com/ByteDance-Seed/Depth-Anything-3.git /opt/splatbot/depth-anything-3 \
    && git -C /opt/splatbot/depth-anything-3 checkout "$DA3_COMMIT" \
    && /opt/splatbot/venv/bin/pip install --no-cache-dir -e /opt/splatbot/depth-anything-3 \
    && command -v ffmpeg \
    && command -v ffprobe \
    && command -v colmap \
    && command -v nvcc \
    && /opt/splatbot/venv/bin/ns-process-data --help >/tmp/ns-process-data-help.txt \
    && /opt/splatbot/venv/bin/ns-train --help >/tmp/ns-train-help.txt \
    && /opt/splatbot/venv/bin/ns-export --help >/tmp/ns-export-help.txt \
    && /opt/splatbot/venv/bin/ns-render --help >/tmp/ns-render-help.txt \
    && /opt/splatbot/venv/bin/rembg --help >/tmp/rembg-help.txt \
    && /opt/splatbot/venv/bin/da3 --help >/tmp/da3-help.txt \
    && mkdir -p /root/.u2net \
    && curl -fsSL \
      https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2net.onnx \
      -o /root/.u2net/u2net.onnx

RUN colmap -h | sed -n '1p' \
    && /opt/splatbot/venv/bin/python - <<'PY'
import importlib.metadata as metadata
import torch

for package in ("nerfstudio", "gsplat", "rembg", "onnxruntime", "torch", "depth-anything-3", "xformers"):
    try:
        version = metadata.version(package)
    except metadata.PackageNotFoundError:
        version = "missing"
    print(f"{package}={version}")
import depth_anything_3  # noqa: F401
import xformers  # noqa: F401
print(f"torch_cuda_available={torch.cuda.is_available()}")
PY
