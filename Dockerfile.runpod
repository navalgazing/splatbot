FROM runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV SPLATBOT_RUNPOD_VENV=/opt/splatbot/venv
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=/opt/splatbot/venv/bin:/usr/local/cuda/bin:$PATH
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
ENV TORCH_CUDA_ARCH_LIST=8.9
ENV TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
ENV TORCH_EXTENSIONS_DIR=/workspace/torch_extensions
ENV TORCHINDUCTOR_CACHE_DIR=/workspace/torch_inductor
ENV TRITON_CACHE_DIR=/workspace/triton_cache
ENV CUDA_CACHE_PATH=/workspace/cuda_cache
ENV XDG_CACHE_HOME=/workspace/.cache
ENV TORCH_HOME=/workspace/.cache/torch
ENV U2NET_HOME=/root/.u2net
ENV QT_QPA_PLATFORM=offscreen

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      colmap \
      curl \
      ffmpeg \
      openssh-client \
      python3 \
      python3-pip \
      python3-venv \
      rsync \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv --system-site-packages /opt/splatbot/venv \
    && /opt/splatbot/venv/bin/pip install --upgrade pip \
    && /opt/splatbot/venv/bin/pip install \
      aiosqlite \
      boto3 \
      nerfstudio \
      pydantic-settings \
      python-dotenv \
      python-telegram-bot \
      'rembg[cpu,cli]' \
    && command -v ffmpeg \
    && command -v ffprobe \
    && command -v colmap \
    && command -v nvcc \
    && command -v ns-process-data \
    && command -v ns-train \
    && command -v ns-export \
    && command -v ns-render \
    && command -v rembg \
    && mkdir -p /root/.u2net \
    && curl -fsSL \
      https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2net.onnx \
      -o /root/.u2net/u2net.onnx

RUN colmap -h | sed -n '1p' \
    && /opt/splatbot/venv/bin/python - <<'PY'
import importlib.metadata as metadata
import torch

for package in ("nerfstudio", "gsplat", "rembg", "onnxruntime", "torch"):
    try:
        version = metadata.version(package)
    except metadata.PackageNotFoundError:
        version = "missing"
    print(f"{package}={version}")
print(f"torch_cuda_available={torch.cuda.is_available()}")
PY
